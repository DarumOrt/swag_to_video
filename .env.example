# Copy to .env and fill in locally. .env is gitignored — never commit real values.
# The app itself runs fully in the browser and needs no secrets.

# Used only by the model upload script in scripts/models/ (run locally by the repo owner).
# Create a write token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Hugging Face repo that hosts the pinned model weights, e.g. username/swagtovideo-models
HF_MODELS_REPO=
